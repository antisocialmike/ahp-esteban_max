FROM jenkins/jenkins:lts-jdk21

# Skip the interactive setup wizard on first boot
ENV JAVA_OPTS="-Djenkins.install.runSetupWizard=false"
ENV CASC_JENKINS_CONFIG=/usr/share/jenkins/casc.yaml

USER root

# Tools required by the Jenkinsfile stages:
# - git for checkout
# - Node.js 20 + npm for dependency install and tests
# - Docker CLI to build images from Jenkins
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git gnupg docker-cli \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER jenkins

# Install plugins (including JCasC) from the list in the repo
COPY jenkins/plugins.txt /usr/share/jenkins/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/plugins.txt

# Copy the JCasC config so Jenkins auto-configures on every fresh boot
COPY jenkins/casc.yaml /usr/share/jenkins/casc.yaml
