# Variables de entorno de ejemplo para docker-compose
# Modo local por defecto
DB_CLIENT=sqlite
DATABASE_URL=
DB_SSL=false
DB_FILE=/app/data/ahp.sqlite
SESSION_DB_FILE=sessions.sqlite
SESSION_DB_DIR=/app/data
SESSION_SECRET=replace-me-with-a-secure-secret
REDIS_URL=
REDIS_PREFIX=ahp:sess:
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
N8N_WEBHOOK_URL=https://n8n.mosht.mx/webhook/pruebaArchivos

# Ejemplo de modo local cloud-ready
# DB_CLIENT=postgres
# DATABASE_URL=postgres://ahp:ahp_dev_password@postgres:5432/ahp
# REDIS_URL=redis://redis:6379
# S3_BUCKET=ahp-uploads
# S3_ENDPOINT=http://minio:9000
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin123
# S3_PUBLIC_BASE_URL=http://localhost:9000/ahp-uploads

# Mapeo para AWS
# DATABASE_URL=postgres://<user>:<password>@<rds-endpoint>:5432/<db>
# REDIS_URL=redis://<elasticache-endpoint>:6379
# S3_BUCKET=<bucket-name>
# S3_PUBLIC_BASE_URL=https://<bucket-name>.s3.us-east-1.amazonaws.com
